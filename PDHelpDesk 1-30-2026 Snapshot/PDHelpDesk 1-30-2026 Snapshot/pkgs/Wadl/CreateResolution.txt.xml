<application xmlns:xml="http://www.w3.org/XML/1998/namespace" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:service="https://power-apis-usgov001-public.azure-apihub.us/apim/logicflows" xmlns:siena="http://schemas.microsoft.com/MicrosoftProjectSiena/WADL/2014/11" siena:serviceId="CreateResolution.txt" xmlns="http://wadl.dev.java.net/2009/02">
  <doc title="CreateResolution.txt" />
  <grammars>
    <jsonTypes targetNamespace="https://power-apis-usgov001-public.azure-apihub.us/apim/logicflows" xmlns="http://schemas.microsoft.com/MicrosoftProjectSiena/WADL/2014/11">
      <string name="ManualTriggerInput_TicketTitle_Inputs_def" />
      <string name="ManualTriggerInput_TicketDescription_Inputs_def" />
      <string name="ManualTriggerInput_Comments_Inputs_def" />
      <string name="ManualTriggerInput_Tags_Inputs_def" />
      <string name="ManualTriggerInput_Summary_Inputs_def" />
      <object name="ManualTriggerInput">
        <property name="TicketTitle_Inputs" type="string" />
        <property name="TicketDescription_Inputs" type="string" />
        <property name="Comments_Inputs" type="string" />
        <property name="Tags_Inputs" type="string" />
        <property name="Summary_Inputs" type="string" />
      </object>
    </jsonTypes>
  </grammars>
  <resources siena:authenticationProviderHref="#PowerAppAuth" base="https://power-apis-usgov001-public.azure-apihub.us/apim/logicflows">
    <resource path="/{connectionId}/triggers/manual/run">
      <param style="template" name="connectionId" type="xs:string" required="true" />
      <method siena:requiresAuthentication="true" name="POST" id="Run">
        <doc title="Runs a logic flow trigger." />
        <request>
          <param style="query" name="api-version" type="xs:string" required="true" fixed="2015-02-01-preview">
            <doc title="The api version" />
          </param>
          <representation mediaType="application/json">
            <param style="plain" name="TicketTitle_Inputs" path="/TicketTitle_Inputs" type="xs:string" required="true" />
            <param style="plain" name="TicketDescription_Inputs" path="/TicketDescription_Inputs" type="xs:string" required="true" />
            <param style="plain" name="Comments_Inputs" path="/Comments_Inputs" type="xs:string" required="true" />
            <param style="plain" name="Tags_Inputs" path="/Tags_Inputs" type="xs:string" required="true" />
            <param style="plain" name="Summary_Inputs" path="/Summary_Inputs" type="xs:string" required="true" />
          </representation>
        </request>
      </method>
    </resource>
  </resources>
  <authenticationProviders xmlns="http://schemas.microsoft.com/MicrosoftProjectSiena/WADL/2014/11">
    <connectionProvider id="PowerAppAuth" siena:connectionProviderId="logicflows" />
  </authenticationProviders>
  <template xmlns="http://schemas.microsoft.com/MicrosoftProjectSiena/WADL/2014/11">
    <variable name="connectionId">
      <modifyParams style="template" name="connectionId" attribute="fixed" />
    </variable>
  </template>
</application>